# Copy to .env and fill in your Org SLM values. Do NOT commit the real .env.
# The database is an embedded DuckDB file (no server), so for local development
# you normally only need to set the ORG_SLM_* values.

# --- Org SLM OpenAI-compatible endpoint) ---
ORG_SLM_BASE_URL=https://llm.maqsoftware.net/v1
ORG_SLM_API_KEY=
ORG_SLM_MODEL=qwen-3.6-27b

# --- Database (embedded DuckDB file; no server needed) ---
DUCKDB_PATH=spend.duckdb

# --- Agent tuning (optional) ---
MAX_SQL_RETRIES=2
ROW_LIMIT=1000

# --- SLM latency controls (optional; defaults shown) ---
# Disable reasoning-model <think> traces for a large speed-up (needs a vLLM-style endpoint
# that accepts chat_template_kwargs, e.g. Qwen3). Set to false for other backends.
SLM_DISABLE_THINKING=true
# Per-call timeout (seconds), network retries, and cap on generated tokens.
ORG_SLM_TIMEOUT=60
ORG_SLM_MAX_RETRIES=1
ORG_SLM_MAX_TOKENS=512
# Use the SLM to phrase answers (a 2nd, slower call). false = instant deterministic summaries.
SUMMARISE_WITH_LLM=false
# Warm the model on server startup so the first question isn't the cold-start victim.
WARM_SLM_ON_START=true
